# Python
__pycache__/
*.py[cod]
*$py.class
*.so
build/
dist/
*.egg-info/
*.egg
.ruff_cache/

# Virtual environments
.env
.venv
env/
venv/

# IDEs
.vscode/
.idea/
*.swp
*.swo
*~

# OS (macOS)
.DS_Store
._*

# MoneyBin runtime state (profiles, config, data, logs) when running in-repo
/.moneybin/

# Profile state materialized at the repo root by older builds, when MONEYBIN_HOME
# anchored to <root> instead of <root>/.moneybin. Never shipped.
/profiles/

# Scratch / local dev artifacts (root-level screenshots, temp dirs, design handoff bundles)
.tmp/
/*.png
*.zip

# Data files (exclude sensitive financial data)
data/
*.csv
*.pdf
*.xlsx
*.xls
# The synthetic generator's persona and merchant definitions are invented data,
# not financial records. `data/` above excludes the directory itself, so git
# never descends into it and negating the files alone would not work — the
# directory has to be re-included. Without this, a NEW persona or catalog is
# silently absent from every commit while the ones predating the rule stay
# tracked, so the generator looks fine locally and ships broken.
!src/moneybin/synthetic/data/
# SQLMesh seed data is safe to track (static reference data, not financial)
!src/moneybin/sqlmesh/models/seeds/*.csv
# Test fixtures are synthetic/non-sensitive and must be tracked for CI
!tests/fixtures/*.csv
!tests/fixtures/*.pdf
!tests/fixtures/**/*.csv
!tests/moneybin/fixtures/*.csv
!tests/moneybin/test_extractors/test_pdf/fixtures/*.pdf
# Built-in CSV profiles are static config bundled with the package (not financial data)
!src/moneybin/data/
# Synthetic test data (YAML merchant catalogs + persona definitions, not financial data)
!src/moneybin/testing/synthetic/data/
# Scenario YAML definitions (declarative test scenarios, not financial data)
!src/moneybin/testing/scenarios/data/
!tests/scenarios/data/
!tests/scenarios/data/**

# Database files
*.duckdb
*.db
*.sqlite
*.sqlite3

# Logs
*.log
logs/

# Jupyter Notebook
.ipynb_checkpoints

# SQLMesh
src/moneybin/sqlmesh/.cache/
src/moneybin/sqlmesh/logs/

# Profile state materialized inside the package dir when MONEYBIN_HOME resolves
# in-tree. Never shipped; tests/e2e/test_wheel_packaging.py would false-fail on it.
src/moneybin/profiles/

# Environment variables and secrets
.env
.env.local
.env.*.local
*.key
*.pem

# Test coverage
htmlcov/
.coverage
.coverage.*
.pytest_cache/

# dbt build artifacts
target/

# Pyright type checking
pyrightconfig.json

# Claude Code local settings (personal, not shared)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# MCP config (contains local paths and credentials)
.mcp.json
.cursor/mcp.json
.playwright-mcp

# Private docs (strategy, specs, notes — not for open source)
private/

# Git worktrees (isolated workspaces)
.worktrees/
.claude/worktrees/

# Visual-companion brainstorm mockups (superpowers plugin)
.superpowers/
